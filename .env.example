# ── Server-only (never exposed to the browser; set these in Vercel → Settings → Environment Variables) ──
# Postgres connection string (Neon, Supabase, Vercel Postgres or any Postgres 14+). Unset locally = embedded PGlite in .data/
DATABASE_URL=
# Comma-separated origins allowed to call the API with credentials (the site's own origin is always allowed)
ALLOWED_ORIGINS=https://tru-linq.vercel.app,https://ausystems.github.io
# Comma-separated emails that get the admin role on sign-up / sign-in (reviewers who decide verifications)
ADMIN_EMAILS=
# Optional: transactional email (Resend). Without it, password-reset and contact emails are stored but not delivered.
RESEND_API_KEY=
EMAIL_FROM="Trulinq <no-reply@trulinq.com>"
# Optional: document storage for verification uploads (Vercel Blob). Without it uploads are refused with 503.
BLOB_READ_WRITE_TOKEN=
# Optional: billing (Stripe). Without it checkout is refused with 503 and plans stay "unconfigured".
STRIPE_SECRET_KEY=
# Where the site lives, used in emails and the referral link shown to members
APP_ORIGIN=https://tru-linq.vercel.app

# ── Public (baked into the frontend bundle at build time; safe to expose) ──
# Where the browser reaches the API. Leave unset for same-origin (/api). GitHub Pages builds must point at the Vercel API.
VITE_API_BASE=
