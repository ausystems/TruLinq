{
  "name": "trulinq",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "gen": "node scripts/gen-members.mjs",
    "predev": "npm run gen && npm run db:bundle",
    "prebuild": "npm run gen && npm run db:bundle",
    "deploy": "node scripts/deploy-pages.mjs",
    "dev:api": "tsx server/dev.ts",
    "db:bundle": "node scripts/bundle-migrations.mjs",
    "db:seed:gen": "node scripts/gen-seed.mjs && npm run db:bundle",
    "db:migrate": "tsx scripts/migrate.ts",
    "vercel-build": "npm run db:migrate && npm run build",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "pretest": "npm run db:bundle",
    "admin": "tsx scripts/admin.ts",
    "dev:web": "vite --port 5180 --strictPort"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "pg": "^8.23.0",
    "three": "^0.186.0",
    "vite": "^8.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "eslint": "^10.11.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
